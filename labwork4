module Labwork4(
    input logic clk,
    output logic [7:0] leds
);

// data memory
logic [7:0] data_mem [0:15];

// instruction memory
logic [15:0] inst_mem [0:7];

// program counter
logic [2:0] pc;

// slow counter for 1 second delay
logic [26:0] counter;


logic [2:0] op;
logic [3:0] addr1, addr2;


logic [7:0] A, B, result;

// initialize memories
initial begin
 
    data_mem[10] = 8'd10;
    data_mem[15] = 8'd15;

    inst_mem[0] = 16'b000_1010_00000_1111; // reg10 + reg15
    inst_mem[1] = 16'b000_1111_00000_1010; // reg15 + reg10
    inst_mem[2] = 16'b001_1010_00000_1111; // reg10 - reg15
    inst_mem[3] = 16'b110_1111_00000_0000; // ~reg15
    inst_mem[4] = 16'b101_1010_00000_1111; // reg10 | reg15
    inst_mem[5] = 16'b0;
    inst_mem[6] = 16'b0;
    inst_mem[7] = 16'b0;

    pc      = 0;
    counter = 0;
end

always_ff @(posedge clk) begin

    if (counter < 27'd99999999) begin
        counter <= counter + 1;
    end else begin
        counter <= 0;

        // decode instruction
        op    <= inst_mem[pc][15:13];
        addr1 <= inst_mem[pc][12:9];
        addr2 <= inst_mem[pc][3:0];

        // read operands from data memory
        A <= data_mem[addr1];
        B <= data_mem[addr2];
        case (inst_mem[pc][15:13])
            3'b000: leds <= data_mem[inst_mem[pc][12:9]] + data_mem[inst_mem[pc][3:0]];
            3'b001: leds <= data_mem[inst_mem[pc][12:9]] - data_mem[inst_mem[pc][3:0]];
            3'b010: leds <= data_mem[inst_mem[pc][12:9]] << 1;
            3'b011: leds <= data_mem[inst_mem[pc][12:9]] >> 1;
            3'b100: leds <= data_mem[inst_mem[pc][12:9]] & data_mem[inst_mem[pc][3:0]];
            3'b101: leds <= data_mem[inst_mem[pc][12:9]] | data_mem[inst_mem[pc][3:0]];
            3'b110: leds <= ~data_mem[inst_mem[pc][12:9]];
            3'b111: leds <= data_mem[inst_mem[pc][12:9]] ^ data_mem[inst_mem[pc][3:0]];
            default: leds <= 8'b0;
        endcase

        // next instruction
        if (pc == 3'd4)
            pc <= 3'd0;
        else
            pc <= pc + 1;
    end

end

endmodule



## Nexys4 DDR - Labwork4 Constraint File

## Clock signal
set_property -dict { PACKAGE_PIN E3    IOSTANDARD LVCMOS33 } [get_ports { clk }];
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports { clk }];
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets clk_IBUF];

## LEDs (ALU sonucu - 8 bit)
set_property -dict { PACKAGE_PIN H17   IOSTANDARD LVCMOS33 } [get_ports { leds[0] }];
set_property -dict { PACKAGE_PIN K15   IOSTANDARD LVCMOS33 } [get_ports { leds[1] }];
set_property -dict { PACKAGE_PIN J13   IOSTANDARD LVCMOS33 } [get_ports { leds[2] }];
set_property -dict { PACKAGE_PIN N14   IOSTANDARD LVCMOS33 } [get_ports { leds[3] }];
set_property -dict { PACKAGE_PIN R18   IOSTANDARD LVCMOS33 } [get_ports { leds[4] }];
set_property -dict { PACKAGE_PIN V17   IOSTANDARD LVCMOS33 } [get_ports { leds[5] }];
set_property -dict { PACKAGE_PIN U17   IOSTANDARD LVCMOS33 } [get_ports { leds[6] }];
set_property -dict { PACKAGE_PIN U16   IOSTANDARD LVCMOS33 } [get_ports { leds[7] }];
